# Discord Bot Token
DISCORD_TOKEN=

# ID of the channel the bot should relay messages in
CHANNEL_ID=

# Discord OAuth2 for Admin Panel
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=1-
OAUTH_CALLBACK=https://discord.examaple.com/auth/discord/callback

# Comma-separated Discord User IDs who are allowed admin access
ADMIN_IDS=

# Port your app should run on
PORT=3000
